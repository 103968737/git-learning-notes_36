# 复制为 .env 后按需修改：Copy-Item .env.example .env
# docker compose 会自动读取同目录下的 .env

# --- 端口映射（被占用时改成其他空闲端口） ---
OLLAMA_PORT=11434
WEBUI_PORT=3000

# --- Ollama 运行参数 ---
# 模型在显存中的保留时间，例如 5m、1h、-1（常驻，直到手动停止）
OLLAMA_KEEP_ALIVE=5m
# 并发请求数；显存紧张时设为 1
OLLAMA_NUM_PARALLEL=2

# --- Open WebUI ---
# 是否开启登录鉴权：本机试用 false，多人/局域网访问请改 true
WEBUI_AUTH=false

# --- 默认模型（脚本与示例的默认值，不会被 compose 自动读取） ---
MODEL_NAME=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
